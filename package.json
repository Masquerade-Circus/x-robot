{
  "name": "x-robot",
  "version": "1.1.0",
  "description": "X-Robot is a finite state machine library for nodejs and for the web.",
  "source": "lib/index.ts",
  "main": "dist/index.min.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.min.js",
  "browser": "dist/index.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./documentate": {
      "import": "./dist/documentate/index.mjs",
      "require": "./dist/documentate/index.js"
    },
    "./validate": {
      "import": "./dist/validate/index.mjs",
      "require": "./dist/validate/index.js"
    },
    "./devtools": {
      "import": "./dist/devtools/index.mjs",
      "require": "./dist/devtools/index.js"
    },
    "./utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Masquerade-Circus/x-robot.git"
  },
  "author": "Masquerade-Circus <christian@masquerade-circus.net>",
  "license": "Apache-2.0",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "mocha --recursive --no-timeouts --exit --require ts-node/register --enable-source-maps tests/**/*.test.ts",
    "test:core": "mocha --recursive --no-timeouts --exit --require ts-node/register --enable-source-maps tests/**/*.test.ts",
    "test:shared": "npm test --workspace @x-robot/shared",
    "test:react": "npm test --workspace @x-robot/react",
    "test:vue": "npm test --workspace @x-robot/vue",
    "test:react:smoke": "npm run test:smoke --workspace @x-robot/react",
    "test:vue:smoke": "npm run test:smoke --workspace @x-robot/vue",
    "test:packages": "npm run test:shared && npm run test:react && npm run test:vue",
    "test-cjs": "mocha --recursive --no-timeouts --exit --enable-source-maps tests/**/*.test.js",
    "test-mjs": "mocha --recursive --no-timeouts --exit --enable-source-maps tests/**/*.test.mjs",
    "test-min": "mocha --recursive --no-timeouts --exit --enable-source-maps tests/**/*.test.min.js",
    "test-all": "bun run test && bun run test-cjs && bun run test-mjs && bun run test-min",
    "dev:test": "nodemon -e ts,js -w ./tests -w ./lib --exec 'bun run test'",
    "build": "node build.js",
    "build:core": "node build.js",
    "build:shared": "npm run build --workspace @x-robot/shared",
    "build:react": "npm run build --workspace @x-robot/react",
    "build:vue": "npm run build --workspace @x-robot/vue",
    "build:react:publish": "npm run build --workspace @x-robot/react",
    "build:packages": "npm run build:shared && npm run build:react && npm run build:vue",
    "verify:react:publish": "npm run build:core && npm run build:react:publish && npm run test:react && npm run test:react:smoke && mocha --no-timeouts --exit --require ts-node/register --enable-source-maps tests/react-publishability.test.ts",
    "verify:vue:publish": "npm run build:core && npm run build:vue && npm run test:vue && npm run test:vue:smoke && mocha --no-timeouts --exit --require ts-node/register --enable-source-maps tests/vue-publishability.test.ts",
    "commit": "git add . && git-cz && git push",
    "release": "release-it --verbose",
    "release-test": "release-it --dry-run --verbose",
    "docs": "bun run build && bun tests-benchmark/generate-report.ts && bun scripts/generate-docs-diagrams.ts && typedoc && remark . -o && bun scripts/sync-version-mentions.ts && bun scripts/generate-llms-full.ts"
  },
  "files": [
    "lib",
    "dist",
    "types",
    "vendor"
  ],
  "keywords": [
    "finite state machine",
    "fsm",
    "state machine",
    "state",
    "machine",
    "functional",
    "functional programming",
    "frozen state",
    "pure ui",
    "user interface",
    "statechart",
    "finite automata",
    "immutable"
  ],
  "devDependencies": {
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/bun": "^1.3.10",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.14.47",
    "expect": "^28.1.1",
    "gzip-size": "^7.0.0",
    "jsdom": "^29.1.1",
    "mermaid": "^11.15.0",
    "mocha": "^10.0.0",
    "nodemon": "^2.0.13",
    "release-it": "^15.1.1",
    "remark-cli": "^11.0.0",
    "robot3": "^0.3.1",
    "terser": "^5.9.0",
    "ts-node": "^10.8.2",
    "tsc": "^2.0.3",
    "tsc-prog": "^2.2.1",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.23.2",
    "typedoc-plugin-markdown": "^3.13.1",
    "typedoc-plugin-mdn-links": "^2.0.0",
    "typedoc-plugin-merge-modules": "^4.0.0",
    "typedoc-plugin-remove-references": "^0.0.6",
    "typescript": "^4.7.4",
    "xstate": "^4.38.3"
  },
  "overrides": {
    "minimist": "^1.2.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release-it": {
    "plugins": {
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "feature",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance Improvements"
            },
            {
              "type": "revert",
              "section": "Reverts"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "style",
              "section": "Styles"
            },
            {
              "type": "chore",
              "section": "Miscellaneous Chores"
            },
            {
              "type": "refactor",
              "section": "Code Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "build",
              "section": "Build System"
            },
            {
              "type": "ci",
              "section": "Continuous Integration"
            }
          ]
        }
      }
    },
    "git": {
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true
    },
    "hooks": {
      "after:bump": [
        "bun run docs"
      ]
    }
  }
}
