{
  "name": "@x-robot/vue",
  "version": "1.1.0",
  "description": "Official Vue adapter for x-robot.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Masquerade-Circus/x-robot.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Masquerade-Circus/x-robot/tree/main/packages/vue",
  "bugs": {
    "url": "https://github.com/Masquerade-Circus/x-robot/issues"
  },
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "mocha --no-timeouts --exit --require ts-node/register --require tsconfig-paths/register --require tests/setup.ts --enable-source-maps tests/**/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "vue": ">=3",
    "x-robot": "*"
  },
  "keywords": [
    "vue",
    "state machine",
    "fsm",
    "x-robot"
  ],
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^9.1.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "vue": "^3.5.13"
  }
}
